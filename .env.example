# =============================================================================
# Goala Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys (Required)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# For DeepSeek provider, also set OPENAI_API_KEY to your DeepSeek API key
# This is because DeepSeek uses OpenAI-compatible API
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Choose which LLM provider to use: 'groq' or 'deepseek' or 'ollama'
LLM_PROVIDER=groq

# Groq model selection (only used if LLM_PROVIDER=groq)
# Options: "llama-3.3-70b-versatile", "qwen/qwen3-32b", "openai/gpt-oss-120b"
GROQ_LLM_MODEL=openai/gpt-oss-120b

# DeepSeek model selection (only used if LLM_PROVIDER=deepseek)
# Options: "deepseek-chat", "deepseek-reasoner"
DEEPSEEK_LLM_MODEL=deepseek-chat

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# Document Processing Configuration
# -----------------------------------------------------------------------------
# Language for PDF processing (ISO 639-1 code, e.g., 'hun' for Hungarian, 'eng' for English)
PDF_LANGUAGE=hun

# PDF partitioning strategy (used by unstructured library)
# Options: "auto", "fast", "hi_res", "ocr_only"
# - "auto": Smart selection (fast for text-heavy, hi_res for tables)
# - "fast": Quick extraction fo`r text-based PDFs
# - "hi_res": Best accuracy for complex layouts and tables (slower, requires detectron2)
# - "ocr_only": Force OCR for scanned documents
PDF_STRATEGY=auto

# Chunking configuration (using unstructured's chunk_by_title strategy)
# Hard maximum chunk size in characters (chunks will never exceed this)
CHUNK_MAX_CHARACTERS=500

# Soft maximum chunk size (preferred chunk size before starting a new chunk)
CHUNK_NEW_AFTER_N_CHARS=400

# Character overlap between chunks (applied when text-splitting oversized elements)
CHUNK_OVERLAP=150

# Allow sections to span multiple pages (true/false)
# Set to false to ensure chunks don't cross page boundaries
CHUNK_MULTIPAGE_SECTIONS=true

RETRIEVER_K=4
# -----------------------------------------------------------------------------
# API Keys (for unstructured and embeddings)
# -----------------------------------------------------------------------------

UNSTRUCTURED_API_KEY=wJ3lY7w1Et7uJvjU42sIhrswZ10vJ5

# Pipeline Configuration
# This token is required for using HuggingFace embeddings
# If not set, embeddings will be downloaded on first use
HUGGINGFACE_TOKEN=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
# read token: HUGGINGFACE_TOKEN=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

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=goala

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
NOVNC_PORT=6080

# noVNC Configuration (Vite uses VITE_ prefix for client env)
VITE_NOVNC_URL=http://localhost:6080
# For cloud: set NOVNC_PUBLIC_URL to the public URL of noVNC (e.g. https://yourdomain.com:6080)
# NOVNC_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Database URL (automatically constructed in docker-compose)
# Use this format for local development outside Docker:
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/goala

# -----------------------------------------------------------------------------
# Messenger Bot Configuration
# -----------------------------------------------------------------------------
# Enable or disable the Messenger bot
MESSENGER_ENABLED=true

# Chrome profile path (REQUIRED when bot is enabled)
# For Docker: Use the container path (this is automatically set in docker-compose)
# For local dev: Use your actual Chrome profile path
# Windows: C:\Users\{username}\AppData\Local\Google\Chrome\User Data\Profile 1
# macOS: /Users/{username}/Library/Application Support/Google/Chrome/Profile 1
# Linux: /home/{username}/.config/google-chrome/Profile 1
# Note: Use a dedicated Chrome profile for the bot, not your main profile
MESSENGER_CHROME_PROFILE_PATH=/app/chrome_profile

# Polling interval (seconds) - randomized between min and max
MESSENGER_CHECK_INTERVAL_MIN=10
MESSENGER_CHECK_INTERVAL_MAX=15

# Response delay (seconds) - randomized between min and max
MESSENGER_RESPONSE_DELAY_MIN=2
MESSENGER_RESPONSE_DELAY_MAX=5

# Goala RAG API endpoint (usually http://localhost:8000/chat)
MESSENGER_API_URL=http://localhost:8000/chat
host.docker.internal
