# =============================================================================
# Goala Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys (Required)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# For DeepSeek provider, set OPENAI_API_KEY to your DeepSeek API key
# (DeepSeek uses an OpenAI-compatible API)
OPENAI_API_KEY=

# For OpenRouter provider
OPENROUTER_API_KEY=

# Pipeline Configuration
# Required for using private/gated HuggingFace models for embeddings
# If not set, public models are downloaded on first use without authentication
HUGGINGFACE_TOKEN=

# Required for using the Unstructured API (document partitioning)
UNSTRUCTURED_API_KEY=

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Choose which LLM provider to use: 'groq', 'deepseek', or 'openrouter'
LLM_PROVIDER=groq

# Groq model selection (only used if LLM_PROVIDER=groq)
# Options: "llama-3.3-70b-versatile", "qwen/qwen3-32b", "openai/gpt-oss-120b"
GROQ_LLM_MODEL=openai/gpt-oss-120b

# DeepSeek model selection (only used if LLM_PROVIDER=deepseek)
# Options: "deepseek-chat", "deepseek-reasoner"
DEEPSEEK_LLM_MODEL=deepseek-chat

# OpenRouter model selection (only used if LLM_PROVIDER=openrouter)
OPENROUTER_LLM_MODEL=openai/gpt-oss-120b:exacto

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Retriever Configuration
# -----------------------------------------------------------------------------
# Number of chunks to retrieve when a document filter matches
RETRIEVER_K=6

# Number of chunks to retrieve when no document filter matches (searches all docs)
RETRIEVER_K_UNFILTERED=8

# Auto-detect document references (e.g. "H-68/2024") in the user question
# and scope retrieval to only those chunks — prevents cross-document bleeding
ENABLE_METADATA_FILTER=true

# -----------------------------------------------------------------------------
# Document Processing Configuration
# -----------------------------------------------------------------------------
# Language for PDF processing (ISO 639-1 code, e.g. 'hun' for Hungarian)
PDF_LANGUAGE=hun

# PDF partitioning strategy (used by unstructured library)
# Options: "auto", "fast", "hi_res", "ocr_only"
# - "auto":     Smart selection (fast for text-heavy, hi_res for tables)
# - "fast":     Quick extraction for text-based PDFs
# - "hi_res":   Best accuracy for complex layouts and tables (slower)
# - "ocr_only": Force OCR for scanned documents
PDF_STRATEGY=auto

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------
# Chunking strategy:
#   "semantic"   - Embedding-based: split where cosine similarity drops (one chunk = one idea)
#   "definition" - One chunk per regulation clause / glossary entry
#   "title"      - Unstructured chunk_by_title, character-count-based
CHUNKING_STRATEGY=semantic

# Hard maximum chunk size in characters (chunks will never exceed this) [title strategy]
CHUNK_MAX_CHARACTERS=1000

# Soft maximum chunk size (preferred chunk size before starting a new chunk) [title strategy]
CHUNK_NEW_AFTER_N_CHARS=800

# Character overlap between chunks [title strategy]
CHUNK_OVERLAP=200

# Allow sections to span multiple pages (true/false) [title strategy]
CHUNK_MULTIPAGE_SECTIONS=true

# Semantic chunking options (used when CHUNKING_STRATEGY=semantic)
# breakpoint_threshold_type: "percentile" | "standard_deviation" | "interquartile" | "gradient"
SEMANTIC_CHUNK_BREAKPOINT_TYPE=percentile
# For "percentile": 95 = only the sharpest 5% of similarity drops become splits → larger chunks
SEMANTIC_CHUNK_BREAKPOINT_AMOUNT=95

# Definition-level chunking size guards (used when CHUNKING_STRATEGY=definition)
# Merge tiny fragments below this size into the preceding chunk
DEFINITION_CHUNK_MIN_CHARS=50
# Hard-split entries above this size on sentence boundaries
DEFINITION_CHUNK_MAX_CHARS=2000

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=goala

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Database URL (automatically constructed in docker-compose)
# Use this format for local development outside Docker:
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/goala
